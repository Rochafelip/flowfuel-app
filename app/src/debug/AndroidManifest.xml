<?xml version="1.0" encoding="utf-8"?>
<!--
    Manifest overlay aplicado SOMENTE no build DEBUG (ambos os flavors).
    Adiciona networkSecurityConfig para liberar HTTP em 10.0.2.2 (localhost do emulador).

    Config específica do flavor automotive (CarAppActivity, CarHardwareManager)
    fica em src/automotive/AndroidManifest.xml, não aqui — esse arquivo não pode
    conter nada que dependa de androidx.car.app:app-automotive, porque também é
    aplicado ao flavor mobile (Android Auto via celular real).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:networkSecurityConfig="@xml/network_security_config">
    </application>
</manifest>
